(EXPERT_MASTER_PCB_LAYOUT
  (VERSION 2.9-HIGHEST)
  (BOARD_DIMENSIONS "350mm x 240mm x 1.6mm nominal, 10-layer Rogers RO4003C")
  (PLACEMENT_ZONES
    (ZONE THERMAL_CORE (COMPONENTS CPU_INTEL_I9_14900HX, GPU_NVIDIA_ADA5090M, GPU_NANOWIRE_AI_QUANTUM, NPU_INTEL_TOPS45))
    (ZONE MEMORY (COMPONENTS MEMORY_DDR5X_MICRON[4], MEMORY_HBM3_STACK))
    (ZONE AUDIO_ISOLATED (COMPONENTS DAC_ESS_SABRE_ES9039PRO, AMP_THX_AAA888, DSP_DIRAC_LIVE, OSCILLATOR_AUDIO_PRIMARY, OSCILLATOR_AUDIO_SECONDARY, AUDIO_SPEAKER_STEREO_PAIR[2], AUDIO_SUB_BASS_TRANSDUCER, HW_CONFIG_JUMPERS))
    (ZONE COMMS (COMPONENTS WWAN_MODULE_QUALCOMM_X90, WWAN_X75_MODULE, WIFI7_BT_QUALCOMM_FASTCONNECT, QSFP_DD_PORT_MOLEX, ETHERNET_PORT_CAT8, THUNDERBOLT5_CONTROLLER))
    (ZONE SECURITY_AND_KEYS (COMPONENTS TPM_INFINEON, PLUTON_SEC_CHIP, OPEN_TITAN_ROOT_OF_TRUST, SECURE_ENCLAVE_COPROCESSOR, FINGERPRINT_SENSOR, PROGRAMMABLE_AI_HOTKEY))
