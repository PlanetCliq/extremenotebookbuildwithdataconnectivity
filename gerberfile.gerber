(EXPERT_MASTER_GERBER
  (VERSION 2.9-HIGHEST)
  (LAYERS
    (TopCopper_L1.GBR "Layer1: Signal Microstrip, 2oz copper, FastConnect 7900 / DDR5X")
    (InnerGround_L2.GBR "Layer2: Solid RF Reference Ground Plane")
    (InnerSignal_L3.GBR "Layer3: Stripline PCIe Gen5 x16, HBM3 1024-bit, QSFP-DD 400G")
    (InnerPower_L4.GBR "Layer4: Split Power Plane 1.2V Core / 1.1V Mem / 1.0V QPU")
    (InnerGround_L5.GBR "Layer5: Solid Ground Shield Barrier Matrix")
    (InnerSignal_L6.GBR "Layer6: EC Discrete Kill Switches / AI Hotkey NMI / Fingerprint SPI")
    (InnerPower_L7.GBR "Layer7: High-Voltage Bus 48V EPR / 12V DC / 11.1V Solid-State Battery")
    (InnerSignal_L8.GBR "Layer8: Dual NVMe Gen5 x4 / SD Express 8.0 Striplines")
    (InnerGround_L9.GBR "Layer9: Isolated Star Ground for Audio & Crystek Master Clocks")
    (BottomCopper_L10.GBR "Layer10: Audio Transducers, Sub-Bass Driver, Knowles Speakers, 2oz copper")
  )
  (DRILLS
    (PrimaryDrill.DRL "0.10mm Laser Microvias, 0.25mm-0.50mm Mechanical PTH")
    (Backdrill_PCIe_Gen5.DRL "Controlled depth backdrill stub removal <0.10mm on Gen5/QSFP-DD")
  )
)
